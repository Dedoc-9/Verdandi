{
  "format": "VERDANDI-INPUT-CASES",
  "version": "1",
  "contract": "1",
  "map": "tactical",
  "values": "true, false and null as JSON writes them; a number as f and the 16 hex digits of its bits, big-endian; a string as s and the string; a list as {\"list\": [...]}; a record as {\"record\": [[field, value], ...]}, its fields in the order written",
  "start": "a new state at spawn A, for each case",
  "cases": [
    {"name": "nothing pressed", "class": "admitted", "steps": [{"input": {"record": []}, "expect": "tick"}]},
    {"name": "every field, each with an admitted value", "class": "admitted", "steps": [{"input": {"record": [["b", false], ["dpitch", "f3f847ae147ae147b"], ["dyaw", "f3fd0000000000000"], ["f", true], ["fire", true], ["jump", true], ["l", false], ["r", true], ["reset", false], ["side", "sB"]]}, "expect": "tick"}]},
    {"name": "forward, three ticks", "class": "admitted", "steps": [{"input": {"record": [["f", true]]}, "expect": "tick"}, {"input": {"record": [["f", true]]}, "expect": "tick"}, {"input": {"record": [["f", true]]}, "expect": "tick"}]},
    {"name": "a turn of +0", "class": "admitted", "steps": [{"input": {"record": [["dyaw", "f0000000000000000"], ["f", true]]}, "expect": "tick"}]},
    {"name": "a turn of -0, taken as +0", "class": "admitted", "steps": [{"input": {"record": [["dyaw", "f8000000000000000"], ["f", true]]}, "expect": "tick"}], "same_as": "a turn of +0"},
    {"name": "the largest finite turn", "class": "large finite", "steps": [{"input": {"record": [["dyaw", "f7fefffffffffffff"], ["f", true]]}, "expect": "tick"}]},
    {"name": "the largest finite turn, negative", "class": "large finite", "steps": [{"input": {"record": [["dyaw", "fffefffffffffffff"], ["f", true]]}, "expect": "tick"}]},
    {"name": "a turn of 3e6 rad", "class": "large finite", "steps": [{"input": {"record": [["dyaw", "f4146e36000000000"], ["f", true]]}, "expect": "tick"}]},
    {"name": "a turn of 2^21 rad, past the sine's domain before the wrap", "class": "large finite", "steps": [{"input": {"record": [["dyaw", "f4140000000000000"], ["f", true]]}, "expect": "tick"}]},
    {"name": "the smallest subnormal turn", "class": "large finite", "steps": [{"input": {"record": [["dyaw", "f0000000000000001"], ["f", true]]}, "expect": "tick"}]},
    {"name": "the largest finite look up, held at the limit", "class": "large finite", "steps": [{"input": {"record": [["dpitch", "f7fefffffffffffff"], ["fire", true]]}, "expect": "tick"}]},
    {"name": "the largest finite look down, held at the limit", "class": "large finite", "steps": [{"input": {"record": [["dpitch", "fffefffffffffffff"], ["fire", true]]}, "expect": "tick"}]},
    {"name": "side A", "class": "admitted", "steps": [{"input": {"record": [["side", "sA"]]}, "expect": "tick"}]},
    {"name": "reset", "class": "admitted", "steps": [{"input": {"record": [["reset", true]]}, "expect": "tick"}]},
    {"name": "dyaw +Infinity", "class": "not finite", "steps": [{"input": {"record": [["dyaw", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dyaw -Infinity", "class": "not finite", "steps": [{"input": {"record": [["dyaw", "ffff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dyaw NaN", "class": "not finite", "steps": [{"input": {"record": [["dyaw", "f7ff8000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dyaw NaN, the sign set", "class": "not finite", "steps": [{"input": {"record": [["dyaw", "ffff8000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dyaw NaN, a payload", "class": "not finite", "steps": [{"input": {"record": [["dyaw", "f7ff0000000000001"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dpitch +Infinity", "class": "not finite", "steps": [{"input": {"record": [["dpitch", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dpitch -Infinity", "class": "not finite", "steps": [{"input": {"record": [["dpitch", "ffff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dpitch NaN", "class": "not finite", "steps": [{"input": {"record": [["dpitch", "f7ff8000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dpitch NaN, the sign set", "class": "not finite", "steps": [{"input": {"record": [["dpitch", "ffff8000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dpitch NaN, a payload", "class": "not finite", "steps": [{"input": {"record": [["dpitch", "f7ff0000000000001"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "dyaw a string", "class": "not a number", "steps": [{"input": {"record": [["dyaw", "s0.5"]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "dyaw true", "class": "not a number", "steps": [{"input": {"record": [["dyaw", true]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "dyaw null", "class": "not a number", "steps": [{"input": {"record": [["dyaw", null]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "dpitch a list", "class": "not a number", "steps": [{"input": {"record": [["dpitch", {"list": []}]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "dpitch a record", "class": "not a number", "steps": [{"input": {"record": [["dpitch", {"record": []}]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "f 1", "class": "flag", "steps": [{"input": {"record": [["f", "f3ff0000000000000"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "f 0", "class": "flag", "steps": [{"input": {"record": [["f", "f0000000000000000"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "f the string true", "class": "flag", "steps": [{"input": {"record": [["f", "strue"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "f null", "class": "flag", "steps": [{"input": {"record": [["f", null]]}, "expect": "INPUT-FLAG"}]},
    {"name": "jump the empty string", "class": "flag", "steps": [{"input": {"record": [["jump", "s"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "fire a record", "class": "flag", "steps": [{"input": {"record": [["fire", {"record": []}]]}, "expect": "INPUT-FLAG"}]},
    {"name": "reset 1", "class": "flag", "steps": [{"input": {"record": [["reset", "f3ff0000000000000"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "b a list", "class": "flag", "steps": [{"input": {"record": [["b", {"list": [true]}]]}, "expect": "INPUT-FLAG"}]},
    {"name": "side C", "class": "side", "steps": [{"input": {"record": [["side", "sC"]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side a, lower case", "class": "side", "steps": [{"input": {"record": [["side", "sa"]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side the empty string", "class": "side", "steps": [{"input": {"record": [["side", "s"]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side null", "class": "side", "steps": [{"input": {"record": [["side", null]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side true", "class": "side", "steps": [{"input": {"record": [["side", true]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side 1", "class": "side", "steps": [{"input": {"record": [["side", "f3ff0000000000000"]]}, "expect": "INPUT-SIDE"}]},
    {"name": "side AB", "class": "side", "steps": [{"input": {"record": [["side", "sAB"]]}, "expect": "INPUT-SIDE"}]},
    {"name": "the unknown field 'crouch'", "class": "unknown field", "steps": [{"input": {"record": [["crouch", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field 'F'", "class": "unknown field", "steps": [{"input": {"record": [["F", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field '__proto__'", "class": "unknown field", "steps": [{"input": {"record": [["__proto__", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field 'constructor'", "class": "unknown field", "steps": [{"input": {"record": [["constructor", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field 'toString'", "class": "unknown field", "steps": [{"input": {"record": [["toString", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field ''", "class": "unknown field", "steps": [{"input": {"record": [["", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field 'dyaw '", "class": "unknown field", "steps": [{"input": {"record": [["dyaw ", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the unknown field '0'", "class": "unknown field", "steps": [{"input": {"record": [["0", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "the input null", "class": "not a record", "steps": [{"input": null, "expect": "INPUT-NOT-RECORD"}]},
    {"name": "the input a number", "class": "not a record", "steps": [{"input": "f3ff0000000000000", "expect": "INPUT-NOT-RECORD"}]},
    {"name": "the input a string", "class": "not a record", "steps": [{"input": "sf", "expect": "INPUT-NOT-RECORD"}]},
    {"name": "the input true", "class": "not a record", "steps": [{"input": true, "expect": "INPUT-NOT-RECORD"}]},
    {"name": "the input an empty list", "class": "not a record", "steps": [{"input": {"list": []}, "expect": "INPUT-NOT-RECORD"}]},
    {"name": "the input a list of pairs", "class": "not a record", "steps": [{"input": {"list": [{"list": ["sf", true]}]}, "expect": "INPUT-NOT-RECORD"}]},
    {"name": "dyaw infinite, f 1, an unknown zz", "class": "precedence", "steps": [{"input": {"record": [["zz", true], ["f", "f3ff0000000000000"], ["dyaw", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "an unknown a, f 1", "class": "precedence", "steps": [{"input": {"record": [["f", "f3ff0000000000000"], ["a", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "side C, dyaw a string", "class": "precedence", "steps": [{"input": {"record": [["side", "sC"], ["dyaw", "sx"]]}, "expect": "INPUT-NUMBER"}]},
    {"name": "an unknown B before a bad b", "class": "precedence", "steps": [{"input": {"record": [["b", "sx"], ["B", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "walk, jump and side B, then an unknown zzz", "class": "no partial change", "steps": [{"input": {"record": [["f", true], ["jump", true], ["side", "sB"], ["zzz", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}]},
    {"name": "look, turn, walk and fire, then reset not a flag", "class": "no partial change", "steps": [{"input": {"record": [["dpitch", "f3fe0000000000000"], ["dyaw", "f3ff0000000000000"], ["f", true], ["fire", true], ["reset", "sx"]]}, "expect": "INPUT-FLAG"}]},
    {"name": "side B with dyaw NaN", "class": "no partial change", "steps": [{"input": {"record": [["dyaw", "f7ff8000000000000"], ["side", "sB"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "the same refused input, three times", "class": "repeated", "steps": [{"input": {"record": [["dyaw", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}, {"input": {"record": [["dyaw", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}, {"input": {"record": [["dyaw", "f7ff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}]},
    {"name": "two ticks", "class": "after a refusal", "steps": [{"input": {"record": [["dyaw", "f3fd3333333333333"], ["f", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd3333333333333"], ["f", true]]}, "expect": "tick"}]},
    {"name": "a tick, a refusal, a tick", "class": "after a refusal", "steps": [{"input": {"record": [["dyaw", "f3fd3333333333333"], ["f", true]]}, "expect": "tick"}, {"input": {"record": [["f", "f3ff0000000000000"]]}, "expect": "INPUT-FLAG"}, {"input": {"record": [["dyaw", "f3fd3333333333333"], ["f", true]]}, "expect": "tick"}], "same_as": "two ticks"},
    {"name": "twenty ticks of walking, turning, jumping and firing", "class": "after a refusal", "steps": [{"input": {"record": [["dyaw", "f3fa999999999999a"], ["f", true], ["jump", true], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fb999999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fc3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fc999999999999a"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd0000000000000"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd6666666666667"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd999999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fdccccccccccccd"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe0000000000000"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe199999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe4cccccccccccd"], ["f", true], ["jump", true], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe6666666666667"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe8000000000000"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe999999999999a"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3feb333333333334"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3feccccccccccccd"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fee666666666667"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3ff0000000000000"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}]},
    {"name": "the same twenty ticks with six refusals among them", "class": "after a refusal", "steps": [{"input": {"record": [["dyaw", "f3fa999999999999a"], ["f", true], ["jump", true], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fb999999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fc3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fc999999999999a"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd0000000000000"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd6666666666667"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fd999999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fdccccccccccccd"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe0000000000000"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f7ff8000000000000"]]}, "expect": "INPUT-NOT-FINITE"}, {"input": {"record": [["side", "sC"]]}, "expect": "INPUT-SIDE"}, {"input": null, "expect": "INPUT-NOT-RECORD"}, {"input": {"record": [["__proto__", true], ["f", true]]}, "expect": "INPUT-UNKNOWN-FIELD"}, {"input": {"record": [["jump", "f3ff0000000000000"]]}, "expect": "INPUT-FLAG"}, {"input": {"record": [["dpitch", "ffff0000000000000"]]}, "expect": "INPUT-NOT-FINITE"}, {"input": {"record": [["dyaw", "f3fe199999999999a"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe3333333333334"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe4cccccccccccd"], ["f", true], ["jump", true], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe6666666666667"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe8000000000000"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fe999999999999a"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3feb333333333334"], ["f", true], ["jump", true], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3feccccccccccccd"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3fee666666666667"], ["f", true], ["jump", false], ["fire", true]]}, "expect": "tick"}, {"input": {"record": [["dyaw", "f3ff0000000000000"], ["f", true], ["jump", false], ["fire", false]]}, "expect": "tick"}], "same_as": "twenty ticks of walking, turning, jumping and firing"}
  ]
}
