{
 "name": "urdr-game-layer-1",
 "note": "The game layer's runtime closure, carried verbatim from Dedoc-9/Urdr at the tag urdr-oracle-1: the seventeen discrete CORE/VIEW vertical slices (gamegen through cue), their frozen conformance corpora, their red-first suites, their briefs, the D24 game boundary and D25 kinema boundary, and the two exact-arithmetic physics modules kinema reads its radix from. Each file's git_blob is the blob `git ls-tree -r urdr-oracle-1` names at the same path in Urdr; nothing here is computed in Verdandi and nothing in Verdandi's kernel, workshop or shell imports it.",
 "origin": {
  "repo": "Dedoc-9/Urdr",
  "tag": "urdr-oracle-1",
  "commit": "4c8c2451d942ff320a11501b59fbbf2737ec42ce",
  "layout": "each path is the file's path in Urdr at the tag, unchanged"
 },
 "closure": {
  "modules": [
   "gamegen",
   "descent",
   "move",
   "entity",
   "rngstream",
   "descend",
   "loot",
   "combat",
   "heirloom",
   "actionlog",
   "savegame",
   "enact",
   "rerun",
   "statecanon",
   "kinema",
   "chorus",
   "cue"
  ],
  "physics": [
   "field",
   "rational"
  ],
  "why_physics": "kinema imports field.ONE (the frozen Q32.32 radix); field imports rational",
  "why_combat_heirloom": "enact reads combat.py and heirloom.py source as its _DERIVATIONS register",
  "why_chorus": "test_cue's one-way audit lists chorus among the observers it checks",
  "suites": "python -m unittest discover -s tests -p test_*.py, run from this folder",
  "tests": 411
 },
